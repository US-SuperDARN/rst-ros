#!/bin/bash

pkill -KILL -f srr_watchdog.py

if [ "$MAIN_RADAR" = "true" ]; then
  # Kill USRP drivers and CUDA driver on second radar:
  if [ "$TWO_RADAR" = "true" ]; then
    RADAR_2=192.168.100.2
    ssh $USER@$RADAR_2 '/home/$USER/repos/rst-ros/script/stop.radar &' &
  fi

  /home/$USER/repos/SuperDARN_UHD_Server/srr.py stop
fi

killall -INT schedule
sleep 10
killall -9 schedule
killall -9 rtserver
killall -9 fitacfwrite
killall -9 rawacfwrite
killall -9 iqwrite

killall -9 shellserver
killall -9 errlog

killall -9 radar

killall -9 noopscan

