#!/bin/bash

radar='lab'
ch1='a'
ch2='b'

TWO_RADAR='false'
TWO_CHANNEL='false'

# critical tasks

echo "Waiting for errlog to start"
errlog -name ${radar}.${ch1} -lp 41000 &
if [ "$TWO_CHANNEL" = "true" ]; then
  errlog -name ${radar}.${ch2} -lp 42000 &
fi
sleep 1

#echo "Waiting for shellserver to start"
#shellserver -sh RadarShellAa -cp 41001 -sp 45001 -ep 41000 &
#if [ "$TWO_CHANNEL" = "true" ]; then
#  shellserver -sh RadarShellAb -cp 42001 -sp 46001 -ep 42000 &
#fi

# support tasks

echo "Waiting for iqwrite to start"
iqwrite -lp 41101 -ep 41000 -c ${ch1} &
if [ "$TWO_CHANNEL" = "true" ]; then
  iqwrite -lp 42101 -ep 42000 -c ${ch2} &
fi

echo "Waiting for rawacfwrite to start"
rawacfwrite -lp 41102 -ep 41000 -c ${ch1} &
if [ "$TWO_CHANNEL" = "true" ]; then
  rawacfwrite -lp 42102 -ep 42000 -c ${ch2} &
fi

echo "Waiting for fitacfwrite to start"
fitacfwrite -lp 41103 -ep 41000 -c ${ch1} &
if [ "$TWO_CHANNEL" = "true" ]; then
  fitacfwrite -lp 42103 -ep 42000 -c ${ch2} &
fi

echo "Waiting for rtserver to start"
rtserver -rp 41104 -ep 41000 -tp 1024 &
if [ "$TWO_CHANNEL" = "true" ]; then
  rtserver -rp 42104 -ep 42000 -tp 1025 &
fi

/home/$USER/repos/SuperDARN_UHD_Server/tools/optimize_network.sh

# Start USRP drivers and CUDA driver on second radar:
if [ "$TWO_RADAR" = "true" ]; then
  RADAR_2=192.168.100.2
  ssh $USER@$RADAR_2 '/home/$USER/repos/SuperDARN_UHD_Server/tools/optimize_network.sh' &
  ssh $USER@$RADAR_2 'python3 /home/$USER/repos/SuperDARN_UHD_Server/tools/srr_watchdog.py &' &

  sleep 10
fi


python3 /home/$USER/repos/SuperDARN_UHD_Server/tools/srr_watchdog.py server &

sleep 25

if [ "$TWO_RADAR" = "true" ]; then
  ssh $USER@$RADAR_2 '/home/$USER/repos/rst-ros/script/start.remote &' &

  sleep 5
fi

echo "Starting scheduler"
schedule -name ${radar}.${ch1} /data/ros/scd/${radar}.${ch1}.scd &
if [ "$TWO_CHANNEL" = "true" ]; then
  schedule -name ${radar}.${ch2} /data/ros/scd/${radar}.${ch2}.scd &
fi
